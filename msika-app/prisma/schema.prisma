generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SubOffice {
  sub_office_id     Int              @id @default(autoincrement())
  name              String           @db.VarChar(100)
  location          String           @db.VarChar(150)
  markets           Market[]
  collectors        Collector[]
  supervisors       Supervisor[]
  revenue_summaries RevenueSummary[]
}

model Market {
  market_id         Int              @id @default(autoincrement())
  sub_office_id     Int
  sub_office        SubOffice        @relation(fields: [sub_office_id], references: [sub_office_id])
  name              String           @db.VarChar(100)
  location          String           @db.VarChar(150)
  sections          MarketSection[]
  vendors           Vendor[]
  revenue_summaries RevenueSummary[]
}

model MarketSection {
  section_id   Int     @id @default(autoincrement())
  market_id    Int
  market       Market  @relation(fields: [market_id], references: [market_id])
  section_name String  @db.VarChar(100)
  vendors      Vendor[]
}

model Role {
  role_id        Int             @id @default(autoincrement())
  role_name      String          @unique @db.VarChar(50)
  collectors     Collector[]
  supervisors    Supervisor[]
  administrators Administrator[]
  audit_logs     AuditLog[]
}

model Collector {
  collector_id    Int       @id @default(autoincrement())
  role_id         Int
  role            Role      @relation(fields: [role_id], references: [role_id])
  sub_office_id   Int?
  sub_office      SubOffice? @relation(fields: [sub_office_id], references: [sub_office_id])
  full_name       String    @db.VarChar(100)
  mobile_number   String    @db.VarChar(20)
  username        String    @unique @db.VarChar(50)
  password_hash   String    @db.VarChar(255)
  vendors         Vendor[]
  payments        Payment[]
}

model Supervisor {
  supervisor_id Int       @id @default(autoincrement())
  role_id       Int
  role          Role      @relation(fields: [role_id], references: [role_id])
  sub_office_id Int?
  sub_office    SubOffice? @relation(fields: [sub_office_id], references: [sub_office_id])
  full_name     String    @db.VarChar(100)
  username      String    @unique @db.VarChar(50)
  password_hash String    @db.VarChar(255)
}

model Administrator {
  admin_id      Int    @id @default(autoincrement())
  role_id       Int
  role          Role   @relation(fields: [role_id], references: [role_id])
  full_name     String @db.VarChar(100)
  username      String @unique @db.VarChar(50)
  password_hash String @db.VarChar(255)
}

model Vendor {
  vendor_id                Int            @id @default(autoincrement())
  vendor_code              String         @unique @db.VarChar(20)
  market_id                Int
  market                   Market         @relation(fields: [market_id], references: [market_id])
  section_id               Int?
  section                  MarketSection? @relation(fields: [section_id], references: [section_id])
  registered_by_collector_id Int?
  registered_by            Collector?     @relation(fields: [registered_by_collector_id], references: [collector_id])
  full_name                String         @db.VarChar(100)
  mobile_number            String         @db.VarChar(20)
  qr_code                  String?        @db.VarChar(255)
  status                   VendorStatus   @default(Active)
  date_registered          DateTime       @default(now())
  payments                 Payment[]
}

enum VendorStatus {
  Active
  Suspended
  Inactive
}

model FeeType {
  fee_type_id Int       @id @default(autoincrement())
  name        String    @db.VarChar(50)
  amount      Decimal   @db.Decimal(10, 2)
  description String?   @db.VarChar(255)
  payments    Payment[]
}

model PaymentStatus {
  status_id   Int       @id @default(autoincrement())
  status_name String    @unique @db.VarChar(30)
  payments    Payment[]
}

model Payment {
  payment_id               Int           @id @default(autoincrement())
  vendor_id                Int
  vendor                   Vendor        @relation(fields: [vendor_id], references: [vendor_id])
  fee_type_id              Int
  fee_type                 FeeType       @relation(fields: [fee_type_id], references: [fee_type_id])
  status_id                Int
  status                   PaymentStatus @relation(fields: [status_id], references: [status_id])
  verified_by_collector_id Int?
  verified_by              Collector?    @relation(fields: [verified_by_collector_id], references: [collector_id])
  transaction_ref          String?       @db.VarChar(50)
  amount                   Decimal       @db.Decimal(10, 2)
  payment_channel          PaymentChannel
  payment_date             DateTime      @default(now())
}

enum PaymentChannel {
  USSD
  AirtelMoney
  TNMMpamba
}

model RevenueSummary {
  summary_id         Int       @id @default(autoincrement())
  market_id          Int
  market             Market    @relation(fields: [market_id], references: [market_id])
  sub_office_id      Int
  sub_office         SubOffice @relation(fields: [sub_office_id], references: [sub_office_id])
  summary_date       DateTime  @db.Date
  total_amount       Decimal   @db.Decimal(12, 2)
  total_transactions Int

  @@unique([market_id, summary_date])
}

model AuditLog {
  log_id          Int      @id @default(autoincrement())
  user_id         Int
  role_id         Int
  role            Role     @relation(fields: [role_id], references: [role_id])
  action          String   @db.VarChar(150)
  entity_affected String   @db.VarChar(100)
  timestamp       DateTime @default(now())
  ip_address      String   @db.VarChar(45)
}